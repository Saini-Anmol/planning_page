# Copy to .env (which is gitignored) and fill in real values.
#
# Used by:
#   - local dev (V1/utilities/config_loader.py auto-loads .env if present)
#   - docker:   docker run --env-file .env  ...

JKT_DB_HOST=<host-or-ip>
JKT_DB_PORT=3306
JKT_DB_USER=<user>
JKT_DB_PASSWORD=<password>
JKT_DB_DATABASE=jkplanningV1
